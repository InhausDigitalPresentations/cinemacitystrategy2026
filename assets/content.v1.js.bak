  { title: 'No social-to-booking attribution exists today', body: 'Nothing connects a post to a purchase. Until UTMs are applied consistently and Vista data can be joined to GA4, every conversion claim in this industry — including ours — is inference.', need: 'UTM standard + GA4/Vista join' },
  { title: 'No pixel or events API on the booking domain', body: 'Meta CAPI and TikTok Events API cannot fire on a domain we do not measure. Without this, paid optimisation is limited to landing-page views rather than purchases.', need: 'Cross-domain pixel deployment' },
  { title: 'Platform data will not agree with ticketing data', body: 'It never does. Set the expectation now: platform-reported conversions will overstate, last-click will understate, and the truth is a triangulation.', need: 'An agreed reporting convention' },
