const SUCCESS_BANDS = [
  { band: 'Success',        body: 'Link tap rate materially above the 0.067% July baseline, a majority of original output tied to a named room, and at least two recurring formats producing consistent saves without paid support.' },
  { band: 'Underperforming',body: 'Reach holds or grows but link tap rate stays flat. That would tell us the content is working and the destination is not — and the conversation should move to the landing experience rather than to the content plan.' },
  { band: 'Failure',        body: 'Reach falls and link taps stay flat, or the pillars are not produced at the stated cadence. In either case the honest diagnosis is capacity, not strategy, and we would recommend cutting to three pillars rather than running thin across five.' }
];

