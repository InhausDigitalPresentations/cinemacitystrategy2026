const UX_METHOD = {
  scope: 'A note on what this chapter is, and what it is not. We are not proposing to redesign Cinemacity’s booking platform, and this is not a digital product roadmap — that is not our remit and we are not pretending otherwise. But every call to action we write sends someone somewhere, and we think it is worth knowing what happens when they arrive. This chapter is us following our own links to the end and reporting back honestly.',
  observed: 'Public website, robots.txt, terms and offers pages, App Store and Google Play listings — all inspected 6 August 2026.',
  notObserved: 'The live checkout could not be driven end to end. booking.cinemacity.ae is closed to automated access and no browser session was available. Nothing below claims to have been tested that was not.',
  next: 'A moderated mobile walkthrough, a Lighthouse run and a GA4 funnel export would move most of the unverified items into observed fact within a day. We are happy to run that with whoever owns the platform.'
};

