const VISUAL_PRINCIPLES = [
  { n: '01', title: 'The frame is the brand', body: 'Not a logo lockup applied to a distributor still. A consistent frame — edge, ratio, corner mark, room name — that turns any asset into a Cinemacity asset. This is how a chain with no production budget owns material it did not shoot.' },
  { n: '02', title: 'The room is always named', body: 'Every asset states which room it belongs to. It is the positioning made operational, it feeds search, and it is the one rule that cannot be broken.' },
  { n: '03', title: 'Type carries the voice', body: 'A display face for statements, a mono face for specification and metadata. The mono is what makes a screen size feel like a fact rather than a claim. Most House Rules content needs no image at all.' },
  { n: '04', title: 'Black is the default', body: 'Cinema is a dark room. Light comes from the screen, not from the design. Bright, saturated layouts belong to malls and to competitors.' },
  { n: '05', title: 'Each pillar has its own behaviour', body: 'One system, five temperaments. The Room is precise and cold. First Day is loud and handheld. The Late Show is warm and shallow. Second Weekend is fast and editorial. House Rules is pure type. Consistency lives in the frame, not in sameness.' },
  { n: '06', title: 'Distributor assets get adapted, never reposted', body: 'Every studio asset enters the Cinemacity frame, gains a room name, and loses the distributor’s call to action in favour of ours. This is the single highest-volume application of the system.' }
];

